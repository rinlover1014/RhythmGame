# 노트 스크롤 속도 (픽셀/초)
SCROLL_SPEED = 300

# 게임 상태 관리
notes = [
    {"time": t, "lane": l, "hit": False} for t, l in CHART_DATA
]

clock = pygame.time.Clock()
start_ticks = pygame.time.get_ticks()

# 메인 게임 루프
running = True
while running:
    screen.fill(BLACK)
    
    # 경과 시간 계산 (초 단위)
    current_time = (pygame.time.get_ticks() - start_ticks) / 1000.0

    # 이벤트 처리
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        elif event.type == pygame.KEYDOWN:
            if event.key in KEY_MAP:
                pressed_lane = KEY_MAP[event.key]
                # 판정선 근처에 있는 해당 레인의 노트를 판정 (예: ±0.15초 이내)
                for note in notes:
                    if not note["hit"] and note["lane"] == pressed_lane:
                        time_diff = note["time"] - current_time
                        if abs(time_diff) < 0.15:
                            note["hit"] = True
                            print(f"Hit! Lane {pressed_lane}, Diff: {time_diff:.3f}s")
                            break

    # 레인 배경 그리기
    for i in range(LANE_COUNT):
        x = LANE_X_OFFSET + i * LANE_WIDTH
        pygame.draw.rect(screen, GRAY, (x, 0, LANE_WIDTH - 2, SCREEN_HEIGHT))

    # 판정선 그리기
    pygame.draw.line(screen, WHITE, (LANE_X_OFFSET, JUDGE_LINE_Y), (LANE_X_OFFSET + LANE_COUNT * LANE_WIDTH, JUDGE_LINE_Y), 3)

    # 노트 업데이트 및 그리기
    for note in notes:
        if note["hit"]:
            continue
        
        # 노트의 Y 좌표 계산 (판정선을 기준으로 남은 시간에 따라 위에서 아래로 낙하)
        time_to_judge = note["time"] - current_time
        note_y = JUDGE_LINE_Y - (time_to_judge * SCROLL_SPEED)

        # 화면 내에 있는 경우에만 렌더링
        if -NOTE_HEIGHT < note_y < SCREEN_HEIGHT:
            lane_x = LANE_X_OFFSET + note["lane"] * LANE_WIDTH
            pygame.draw.rect(screen, COLORS[note["lane"]], (lane_x + 5, note_y, LANE_WIDTH - 12, NOTE_HEIGHT))

    # 화면 갱신
    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()

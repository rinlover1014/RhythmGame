import pygame


class Lane:
    def __init__(self, x, width, height, key):
        self.x = x
        self.width = width
        self.height = height
        self.key = key
        self.judgement_y = height - 100

    def draw(self, screen):
        # 레인 배경
        pygame.draw.rect(
            screen,
            (40, 40, 40),
            (self.x, 0, self.width, self.height)
        )

        # 레인 오른쪽 경계선
        pygame.draw.line(
            screen,
            (100, 100, 100),
            (self.x + self.width, 0),
            (self.x + self.width, self.height),
            2
        )

        # 판정선
        pygame.draw.line(
            screen,
            (255, 255, 255),
            (self.x, self.judgement_y),
            (self.x + self.width, self.judgement_y),
            3
        )
